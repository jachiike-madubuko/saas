rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Gear catalog — readable by all authenticated users, writable only from admin seed
    match /gearCatalog/{itemId} {
      allow read: if request.auth != null;
      allow write: if false; // seed via Admin SDK or Firebase Console import
    }

    // All user data scoped to the authenticated user
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /habits/{habitId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /stacks/{stackId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /stackSteps/{stepId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /habitCompletions/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /stackCompletions/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /transactions/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /inventory/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
